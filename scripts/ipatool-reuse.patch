+// set-session принимает JSON аккаунта (полученный нативным входом bmrng) из stdin
+// и сохраняет его в keyring — дальше download работает без входа через ipatool.
+func setSessionCmd() *cobra.Command {
+	return &cobra.Command{
+		Use:   "set-session",
+		Short: "Import a pre-authenticated session (account JSON via stdin)",
+		RunE: func(cmd *cobra.Command, args []string) error {
+			data, err := io.ReadAll(os.Stdin)
+			if err != nil {
+				return fmt.Errorf("failed to read stdin: %w", err)
+			}
+			if err := dependencies.AppStore.ImportAccount(data); err != nil {
+				return err
+			}
+			dependencies.Logger.Log().Bool("success", true).Send()
+			return nil
+		},
+	}
+}
